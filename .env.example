# =================================================
# Movie & Series Companion Agent - Environment Configuration
# =================================================
# Copy this file to .env and fill in your actual values

# MongoDB Atlas Connection
# Get free tier at: https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/
MONGODB_DATABASE=moviecompanion

# OpenAI API Key (via LiteLLM)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Configuration
LLM_MODEL=openai/gpt-4o-mini

# TMDB API (Primary movie/TV data source)
# Get free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# OMDB API (Fallback movie data source)
# Get free key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here
OMDB_BASE_URL=http://www.omdbapi.com

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development
LOG_LEVEL=INFO

# Session Configuration
SESSION_SECRET_KEY=your_secret_key_for_sessions_change_this
