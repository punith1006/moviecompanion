# CinePal AI Service Environment Configuration

# ============================================================
# REQUIRED: Copy this file to .env and fill in your API keys
# ============================================================

# OpenAI API Key (required for AI chat functionality)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Model (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# TMDb API Key (required for movie/show data)
# Get yours at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key-here

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=true
